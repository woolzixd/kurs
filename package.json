{
  "name": "kursovaya",
  "version": "1.0.0",
  "description": "DriveCo Администрация",
  "main": "main.js",
  "scripts": {
    "start": "node node_modules\\electron\\cli.js .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.driveco.autosalon",
    "productName": "DriveCo",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "sign": false
    },
    "portable": {
      "artifactName": "DriveCo.exe"
    },
    "files": [
      "main.js",
      "database.js",
      "database.db",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "database.db", "to": "database.db" }
    ]
  }
}